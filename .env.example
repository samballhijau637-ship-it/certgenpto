# ============================================================================
# SUPABASE
# ============================================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxx...   # Project Settings > API > service_role (RAHASIA, jangan expose ke client)

# ============================================================================
# MIDTRANS
# ============================================================================
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false              # ganti "true" saat go-live
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# ============================================================================
# BREVO (EMAIL)
# ============================================================================
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=noreply@domainanda.com
BREVO_SENDER_NAME=CertGen Pro

# ============================================================================
# FONNTE (WHATSAPP)
# ============================================================================
FONNTE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# KEAMANAN LISENSI (RSA)
# ============================================================================
# Private key dalam format base64 (satu baris). Lihat client/python/generate_keys.py
# untuk cara membuatnya. JANGAN PERNAH commit private key ke git.
LICENSE_RSA_PRIVATE_KEY_B64=

# ============================================================================
# ADMIN DASHBOARD
# ============================================================================
ADMIN_PASSWORD=gantidenganpasswordkuat

# ============================================================================
# CRON JOB
# ============================================================================
# String acak untuk mengamankan endpoint /api/cron/keepalive dari akses luar.
CRON_SECRET=gantidenganstringacak

# ============================================================================
# DOMAIN & LINK (WAJIB DIISI SETELAH DEPLOY KE VERCEL AKUN BARU)
# ============================================================================
# URL domain Vercel/GitHub baru Anda, dipakai untuk callback "Thank You" Midtrans
# (bukan di-setting di dashboard Midtrans, tapi otomatis ikut di setiap request
# lewat pages/api/payment/create.js & pages/api/renew.js).
NEXT_PUBLIC_SITE_URL=https://nama-project-baru-anda.vercel.app

# Link download installer CertGen Pro yang disisipkan otomatis di pesan WA & email lisensi.
DOWNLOAD_LINK=https://nama-project-baru-anda.vercel.app/download
